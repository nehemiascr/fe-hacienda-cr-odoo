<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_extra_node_form" model="ir.ui.view">
        <field name="name">extra_node.form</field>
        <field name="model">eicr.extra_node</field>
        <field name="arch" type="xml">
            <form string="Nodos extra en los Documentos Electrónicos">
                <sheet string="Nodos extra en los Documentos Electrónicos">
                    <group col="4">
                      <field name="name"/>
                      <field name="sequence"/>
                    </group >
                    <group col="2">
                      <field name="node_location"/>
                      <label for="valid_location" string="Ubicación Inválida"  attrs="{'invisible': [('valid_location','=', True)]}" style="font-weight:bold; color:red;"/>
                      <label for="valid_location" string="Ubicación Válida"  attrs="{'invisible': [('valid_location','=', False)]}" style="font-weight:bold; color:green;"/>
                      <field name="valid_location" invisible="1"/>
                    </group>
                    <group col="2">
                      <field name="node_definition"/>
                        <label for="valid_definition" string="Definición Inválida"  attrs="{'invisible': [('valid_definition','=', True)]}" style="font-weight:bold; color:red;"/>
                        <label for="valid_definition" string="Definición Válida"  attrs="{'invisible': [('valid_definition','=', False)]}" style="font-weight:bold; color:green;"/>
                        <field name="valid_definition" invisible="1"/>
                    </group>
                    <newline/>
                    <group col="2">
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="show_in_report"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_extra_node_tree" model="ir.ui.view">
        <field name="name">extra_node.tree</field>
        <field name="model">eicr.extra_node</field>
        <field name="arch" type="xml">
            <tree string="Nodos extra en los Documentos Electrónicos" decoration-danger="not valid_location or not valid_definition">
                <field name="name"/>
                <field name="sequence"/>
                <field name="partner_ids"/>
                <field name="node_location"/>
                <field name="valid_location" invisible="1"/>
                <field name="valid_definition" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_extra_node" model="ir.actions.act_window">
        <field name="name">Nodos extra en los Documentos Electrónicos</field>
        <field name="res_model">eicr.extra_node</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_extra_node" name="Nodos extra" parent="menu_electronic_invoice" sequence="10" action="action_extra_node"/>
    
</data></odoo>